---
import Base from "../layouts/Base.astro";
import LinkCard from "../components/LinkCard.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { profile, links } from "../data/links";
---

<Base title={`${profile.name} | Links`}>
  <main class="w-full max-w-md flex flex-col items-center gap-6">
    <!-- Avatar -->
    <div class="animate-fade-in-up" style="animation-delay: 0ms">
      <img
        src={profile.avatar}
        alt={profile.name}
        class="size-24 rounded-full ring-4 ring-purple-500/30 shadow-lg shadow-purple-500/20"
      />
    </div>

    <!-- Name & Bio -->
    <div class="text-center animate-fade-in-up" style="animation-delay: 100ms">
      <h1 class="text-2xl font-bold">{profile.name}</h1>
      <p class="mt-1 text-gray-400">{profile.bio}</p>
    </div>

    <!-- Links -->
    <div class="w-full flex flex-col gap-3">
      {links.map((link, i) => (
        <LinkCard
          title={link.title}
          url={link.url}
          description={link.description}
          index={i + 2}
        />
      ))}
    </div>

    <!-- Socials -->
    <SocialIcons />
  </main>
</Base>
